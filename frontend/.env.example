# Copy this file to `.env` in the same folder and fill in your own value.
# `.env` is git-ignored, so your Client ID never reaches the repository.
#
# Create the Client ID in Google Cloud Console:
#   APIs & Services  ->  Credentials  ->  Create credentials  ->  OAuth client ID
#   Application type: Web application
#   Authorized JavaScript origins: http://localhost:5173
#
# Leaving this unset is fine: the app then runs in demo mode.

VITE_GOOGLE_CLIENT_ID=
